{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notara",
  "version": "1.0.0",
  "identifier": "com.richmtx.notara",
  "build": {
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/notara/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Notara",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Ricardo Martínez",
    "copyright": "Copyright © 2026 Ricardo Martínez Hernández",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/richmtx/notara",
    "category": "Productivity",
    "shortDescription": "Notas en archivos Markdown, organizadas por carpetas",
    "longDescription": "Notara es una app de escritorio para tomar y organizar notas. Cada nota es un archivo Markdown en una carpeta que tú eliges: sin base de datos y sin formato propietario.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
